{
  "name": "Ask for a Google review after the job is done",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "job-done",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "09df17a9-e942-4b49-8645-50c90d951934",
      "name": "Job completed",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "amount": 2,
        "unit": "hours"
      },
      "id": "7145d748-dccc-4748-b57d-363a32e2d8e6",
      "name": "Wait 2 hours",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "from": "+13125550199",
        "to": "={{ $('Job completed').item.json.body.phone }}",
        "message": "=Hi {{ $('Job completed').item.json.body.first_name }}, it's Acme Heating & Plumbing. How did {{ $('Job completed').item.json.body.tech }} do today? Reply 1-5.",
        "options": {}
      },
      "id": "2819e337-8dc7-4d33-a526-cb26945b4cb1",
      "name": "Ask how it went",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [
        440,
        300
      ],
      "credentials": {
        "twilioApi": {
          "id": "",
          "name": "Twilio account"
        }
      }
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "review-reply",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "4fe9636d-1126-4b07-b5c4-a06ab086a141",
      "name": "Customer replies",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        560
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ parseInt(String($json.body.Body).trim()) }}",
              "rightValue": 4,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "716404a9-68ba-4c91-bf08-8c97ed5dc10d",
      "name": "Happy?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        220,
        560
      ]
    },
    {
      "parameters": {
        "from": "={{ $json.body.To }}",
        "to": "={{ $json.body.From }}",
        "message": "Thank you! If you have 30 seconds, a Google review helps a small shop like ours a lot: https://g.page/r/YOUR_REVIEW_LINK/review",
        "options": {}
      },
      "id": "1bafe726-7c23-4131-b668-b7bf9f2814a9",
      "name": "Send review link",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [
        440,
        480
      ],
      "credentials": {
        "twilioApi": {
          "id": "",
          "name": "Twilio account"
        }
      }
    },
    {
      "parameters": {
        "from": "={{ $json.body.To }}",
        "to": "={{ $json.body.From }}",
        "message": "Sorry to hear that. The owner will call you today to make it right.",
        "options": {}
      },
      "id": "0fb788bd-db68-4661-b27c-64614010e660",
      "name": "Sorry + alert owner",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [
        440,
        640
      ],
      "credentials": {
        "twilioApi": {
          "id": "",
          "name": "Twilio account"
        }
      }
    },
    {
      "parameters": {
        "from": "={{ $('Customer replies').item.json.body.To }}",
        "to": "+13125550100",
        "message": "=Unhappy customer {{ $('Customer replies').item.json.body.From }} rated {{ $('Customer replies').item.json.body.Body }}. Call them today.",
        "options": {}
      },
      "id": "ae90d4a2-2671-469e-a99b-884780563961",
      "name": "Text owner",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [
        660,
        640
      ],
      "credentials": {
        "twilioApi": {
          "id": "",
          "name": "Twilio account"
        }
      }
    },
    {
      "parameters": {
        "content": "## Review request\nTop: your field software (Jobber, Housecall Pro, ServiceTitan via Zapier, etc.) POSTs here when a job closes (phone, first_name, tech).\nBottom: set as your Twilio number's incoming SMS webhook.\n4-5 gets the review link, 1-3 goes to the owner instead of Google.",
        "height": 240,
        "width": 460
      },
      "id": "e7074159-6b83-4750-bdeb-113cf65997d4",
      "name": "Sticky",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    }
  ],
  "connections": {
    "Job completed": {
      "main": [
        [
          {
            "node": "Wait 2 hours",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait 2 hours": {
      "main": [
        [
          {
            "node": "Ask how it went",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Customer replies": {
      "main": [
        [
          {
            "node": "Happy?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Happy?": {
      "main": [
        [
          {
            "node": "Send review link",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Sorry + alert owner",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sorry + alert owner": {
      "main": [
        [
          {
            "node": "Text owner",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}